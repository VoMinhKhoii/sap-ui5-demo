<mvc:View
  controllerName="workshop.dashboard.controller.Home"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:card="sap.f.cards"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:viz.data="sap.viz.ui5.data"
  xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
>
  <Page showHeader="false" class="wsPage">

    <!-- The case at a glance: the question to answer, who asks, and the symptom (sample data, not the answer). -->
    <HBox class="wsHero" wrap="Wrap" alignItems="Center" renderType="Bare">
      <VBox class="wsHeroText" renderType="Bare">
        <Text text="Case 01 · Coding Club" class="wsHeroEyebrow" />
        <Title text="{app>/case/title}" level="H1" wrapping="true" class="wsHeroTitle" />
        <Text text="{app>/case/question}" class="wsHeroQuestion" />
        <Text text="Asked by the {app>/case/client} · {app>/case/deadline}" class="wsHeroMeta" />
      </VBox>
      <f:Card class="wsHeroChart">
        <f:header>
          <card:Header title="{/meta/trend/title}" subtitle="{/meta/trend/subtitle}" />
        </f:header>
        <f:content>
          <viz:VizFrame vizType="line" width="100%" height="15rem" uiConfig="{applicationSet:'fiori'}">
            <viz:dataset>
              <viz.data:FlattenedDataset data="{/trend}">
                <viz.data:dimensions>
                  <viz.data:DimensionDefinition name="Week" value="{month}" />
                </viz.data:dimensions>
                <viz.data:measures>
                  <viz.data:MeasureDefinition name="Seats filled %" value="{actual}" />
                  <viz.data:MeasureDefinition name="Target" value="{plan}" />
                </viz.data:measures>
              </viz.data:FlattenedDataset>
            </viz:dataset>
            <viz:feeds>
              <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Seats filled %,Target" />
              <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Week" />
            </viz:feeds>
          </viz:VizFrame>
        </f:content>
      </f:Card>
    </HBox>

    <!-- The story, and what the answer has to contain -->
    <VBox class="wsSection" renderType="Bare">
      <HBox class="wsRow wsRowTight" renderType="Bare">
        <f:Card class="wsWide">
          <f:header>
            <card:Header title="The story" iconSrc="sap-icon://course-book" />
          </f:header>
          <f:content>
            <VBox class="wsCardBody" renderType="Bare">
              <VBox items="{app>/case/story}" renderType="Bare">
                <Text text="{app>}" class="sapUiSmallMarginBottom" />
              </VBox>
              <MessageStrip text="The president thinks: {app>/case/assumption} Opinions aren't evidence. What does the data say?" type="Information" showIcon="true" />
            </VBox>
          </f:content>
        </f:Card>
        <f:Card>
          <f:header>
            <card:Header title="Page 1 of your app must show" iconSrc="sap-icon://checklist-item" />
          </f:header>
          <f:content>
            <VBox items="{app>/case/mustInclude}" class="wsCardBody" renderType="Bare">
              <VBox class="wsMustItem" renderType="Bare">
                <Label text="{app>title}" design="Bold" wrapping="true" />
                <Text text="{app>text}" />
              </VBox>
            </VBox>
          </f:content>
        </f:Card>
      </HBox>
    </VBox>

    <!-- Three suspects: one action for the whole section, next to its title. -->
    <VBox class="wsSection" renderType="Bare">
      <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="wsSectionHead" renderType="Bare">
        <Title text="Three suspects, one answer" level="H2" titleStyle="H3" />
        <Button text="Test them in the Playground" press=".onGoPlayground" />
      </HBox>
      <HBox class="wsRow wsRowTight" renderType="Bare" items="{app>/case/hypotheses}">
        <f:Card>
          <f:header>
            <card:Header title="{app>id}: {app>title}" subtitle="&quot;{app>suspicion}&quot;" />
          </f:header>
          <f:content>
            <Text text="{app>challenge}" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom" />
          </f:content>
        </f:Card>
      </HBox>
    </VBox>

    <!-- Hints: one card each -->
    <VBox class="wsSection" renderType="Bare">
      <Title text="Stuck? Two hints" level="H2" titleStyle="H3" class="wsSectionHead" />
      <HBox class="wsRow wsRowTight" renderType="Bare" items="{app>/case/hints}">
        <f:Card>
          <f:header>
            <card:Header title="Hint for minute {app>minute}" iconSrc="sap-icon://lightbulb" />
          </f:header>
          <f:content>
            <VBox class="wsCardBody" renderType="Bare">
              <Button text="Show the hint" press=".onRevealHint" visible="{= !${app>shown} }" />
              <Text text="{app>text}" visible="{= !!${app>shown} }" />
            </VBox>
          </f:content>
        </f:Card>
      </HBox>
    </VBox>

    <!-- Marking -->
    <VBox class="wsSection sapUiMediumMarginBottom" renderType="Bare">
      <Panel headerText="How you are marked (100 points)" expandable="true" expanded="false" width="auto">
        <List items="{home>/rubric}" showSeparators="Inner">
          <StandardListItem title="{home>criterion}" description="{home>question}" info="{home>points} pts" wrapping="true" />
        </List>
      </Panel>
    </VBox>
  </Page>
</mvc:View>
