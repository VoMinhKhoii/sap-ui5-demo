<mvc:View
  controllerName="workshop.dashboard.controller.Home"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:card="sap.f.cards"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:viz.data="sap.viz.ui5.data"
  xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
>
  <Page showHeader="false" class="wsPage">

    <!-- The case at a glance: what happened, who asks, and the symptom (sample data, not the answer). -->
    <HBox class="wsHero" wrap="Wrap" alignItems="Center" renderType="Bare">
      <VBox class="wsHeroText" renderType="Bare">
        <Text text="Case 01 · Coding Club" class="wsHeroEyebrow" />
        <Title text="{app>/case/title}" level="H1" wrapping="true" class="wsHeroTitle" />
        <Text text="{app>/case/brief}" class="wsHeroLead" />
        <Button text="Start investigating" press=".onGoPlayground" class="wsHeroButton" />
        <HBox class="wsHeroStats" wrap="Wrap" renderType="Bare">
          <VBox renderType="Bare">
            <Text text="4 days" class="wsHeroStatValue" />
            <Text text="until the sponsor meeting" class="wsHeroStatLabel" />
          </VBox>
          <VBox renderType="Bare">
            <Text text="3" class="wsHeroStatValue" />
            <Text text="suspects, one answer" class="wsHeroStatLabel" />
          </VBox>
          <VBox renderType="Bare">
            <Text text="45 min" class="wsHeroStatValue" />
            <Text text="to crack it and build the app" class="wsHeroStatLabel" />
          </VBox>
        </HBox>
      </VBox>
      <f:Card class="wsHeroChart">
        <f:header>
          <card:Header title="{/meta/trend/title}" subtitle="{/meta/trend/subtitle}" />
        </f:header>
        <f:content>
          <viz:VizFrame vizType="line" width="100%" height="15rem" uiConfig="{applicationSet:'fiori'}">
            <viz:dataset>
              <viz.data:FlattenedDataset data="{/trend}">
                <viz.data:dimensions>
                  <viz.data:DimensionDefinition name="Week" value="{month}" />
                </viz.data:dimensions>
                <viz.data:measures>
                  <viz.data:MeasureDefinition name="Seats filled %" value="{actual}" />
                  <viz.data:MeasureDefinition name="Target" value="{plan}" />
                </viz.data:measures>
              </viz.data:FlattenedDataset>
            </viz:dataset>
            <viz:feeds>
              <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Seats filled %,Target" />
              <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Week" />
            </viz:feeds>
          </viz:VizFrame>
        </f:content>
      </f:Card>
    </HBox>

    <!-- The story -->
    <VBox class="wsSection" renderType="Bare">
      <Title text="The story" level="H2" titleStyle="H3" class="wsSectionHead" />
      <HBox class="wsRow wsRowTight" renderType="Bare">
        <VBox class="wsWide" renderType="Bare">
          <VBox items="{app>/case/story}" renderType="Bare">
            <Text text="{app>}" class="sapUiSmallMarginBottom" />
          </VBox>
        </VBox>
        <VBox renderType="Bare">
          <f:Card class="wsQuestionCard">
            <f:content>
              <VBox class="sapUiSmallMargin" renderType="Bare">
                <Label text="Your question" class="wsQuestionLabel" />
                <Text text="{app>/case/question}" class="wsQuestion" />
              </VBox>
            </f:content>
          </f:Card>
          <MessageStrip text="The president thinks: {app>/case/assumption} Opinions aren't evidence. What does the data say?" type="Information" showIcon="true" class="sapUiSmallMarginTop" />
        </VBox>
      </HBox>
    </VBox>

    <!-- Three suspects: one action for the whole section, next to its title. -->
    <VBox class="wsSection" renderType="Bare">
      <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="wsSectionHead" renderType="Bare">
        <Title text="Three suspects, one answer" level="H2" titleStyle="H3" />
        <Button text="Test them in the Playground" press=".onGoPlayground" />
      </HBox>
      <HBox class="wsRow wsRowTight" renderType="Bare" items="{app>/case/hypotheses}">
        <f:Card>
          <f:header>
            <card:Header title="{app>id}: {app>title}" subtitle="&quot;{app>suspicion}&quot;" />
          </f:header>
          <f:content>
            <Text text="{app>challenge}" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom" />
          </f:content>
        </f:Card>
      </HBox>
    </VBox>

    <!-- What the answer has to contain -->
    <VBox class="wsSection" renderType="Bare">
      <Title text="Page 1 of your app must show" level="H2" titleStyle="H3" class="wsSectionHead" />
      <f:Card width="100%">
        <f:content>
          <List items="{app>/case/mustInclude}" showSeparators="Inner" width="100%">
            <StandardListItem title="{app>title}" description="{app>text}" wrapping="true" />
          </List>
        </f:content>
      </f:Card>
    </VBox>

    <!-- Hints -->
    <VBox class="wsSection" renderType="Bare">
      <Title text="Stuck? Two hints" level="H2" titleStyle="H3" class="wsSectionHead" />
      <VBox items="{app>/case/hints}" renderType="Bare">
        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
          <Button text="Show the hint for minute {app>minute}" icon="sap-icon://lightbulb" press=".onRevealHint" visible="{= !${app>shown} }" />
          <MessageStrip text="Minute {app>minute}: {app>text}" type="Information" customIcon="sap-icon://lightbulb" showIcon="true" visible="{= !!${app>shown} }" />
        </HBox>
      </VBox>
    </VBox>

    <!-- Marking -->
    <VBox class="wsSection sapUiMediumMarginBottom" renderType="Bare">
      <Panel headerText="How you are marked (100 points)" expandable="true" expanded="false" width="auto">
        <List items="{home>/rubric}" showSeparators="Inner">
          <StandardListItem title="{home>criterion}" description="{home>question}" info="{home>points} pts" wrapping="true" />
        </List>
      </Panel>
    </VBox>
  </Page>
</mvc:View>
