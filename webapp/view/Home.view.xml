<mvc:View
  controllerName="workshop.dashboard.controller.Home"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:card="sap.f.cards"
  xmlns:layout="sap.ui.layout"
  xmlns:mvc="sap.ui.core.mvc"
>
  <Page showHeader="false" class="wsPage">
    <VBox class="wsPageIntro">
      <Title text="{app>/case/title}" level="H1" titleStyle="H2" wrapping="true" />
      <Text text="It's {app>/case/today}. Find out what's really going on in the data, then build the SAPUI5 dashboard that makes the answer impossible to miss." class="sapUiSmallMarginTop" />
    </VBox>

    <!-- 1. The story -->
    <VBox class="wsSection">
      <Title text="1. The story" level="H2" />
      <f:Card width="100%" class="wsCaseCard">
        <f:header>
          <card:Header title="Asked by: {app>/case/client}" subtitle="Deadline: {app>/case/deadline}" iconSrc="sap-icon://group" />
        </f:header>
        <f:content>
          <VBox width="100%">
            <VBox items="{app>/case/story}">
              <Text text="{app>}" class="sapUiSmallMarginBottom" />
            </VBox>
            <Text text="{app>/case/question}" class="wsQuestion sapUiSmallMarginTop" />
            <Text text="The president thinks: {app>/case/assumption} Opinions aren't evidence. What does the data say?" class="sapUiSmallMarginTop wsAssumption" />
          </VBox>
        </f:content>
      </f:Card>
    </VBox>

    <!-- 2. Three suspects -->
    <VBox class="wsSection">
      <Title text="2. Three suspects, one answer" level="H2" />
      <HBox class="wsRow wsRowTight" renderType="Bare" items="{app>/case/hypotheses}">
        <f:Card>
          <f:header>
            <card:Header title="{app>id}: {app>title}" subtitle="&quot;{app>suspicion}&quot;" />
          </f:header>
          <f:content>
            <Text text="{app>challenge}" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom" />
          </f:content>
        </f:Card>
      </HBox>
    </VBox>

    <!-- 3. Start -->
    <VBox class="wsSection">
      <Title text="3. Investigate, then build" level="H2" />
      <HBox class="wsRow wsRowTight" renderType="Bare">
        <f:Card class="wsWide">
          <f:header>
            <card:Header title="Your dashboard must include" subtitle="{app>/case/deliverable}" iconSrc="sap-icon://checklist-item" />
          </f:header>
          <f:content>
            <List items="{app>/case/mustInclude}" showSeparators="Inner" width="100%">
              <StandardListItem title="{app>title}" description="{app>text}" wrapping="true" />
            </List>
          </f:content>
        </f:Card>
        <f:Card>
          <f:header>
            <card:Header title="Your tools" subtitle="Keep the kit (this tab) and your app side by side" iconSrc="sap-icon://wrench" />
          </f:header>
          <f:content>
            <VBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom" width="100%">
              <Button text="Query Playground" icon="sap-icon://simulate" type="Emphasized" press=".onGoPlayground" width="100%" />
              <Button text="Open my app (new tab)" icon="sap-icon://action" press=".onOpenApp" width="100%" class="sapUiTinyMarginTop" />
              <Label text="The data: 4 tables" class="sapUiSmallMarginTop" />
              <HBox items="{home>/tables}" wrap="Wrap">
                <GenericTag text="{home>name}" design="StatusIconHidden" press=".onOpenTable" class="sapUiTinyMarginEnd sapUiTinyMarginTop" />
              </HBox>
            </VBox>
          </f:content>
        </f:Card>
      </HBox>
    </VBox>

    <!-- 4. Hints -->
    <VBox class="wsSection">
      <Title text="4. Stuck? Two hints" level="H2" />
      <VBox items="{app>/case/hints}">
        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
          <Button text="Show the hint for minute {app>minute}" icon="sap-icon://lightbulb" press=".onRevealHint" visible="{= !${app>shown} }" />
          <MessageStrip text="Minute {app>minute}: {app>text}" type="Information" customIcon="sap-icon://lightbulb" showIcon="true" visible="{= !!${app>shown} }" />
        </HBox>
      </VBox>
    </VBox>

    <!-- 5. Plan and marking -->
    <VBox class="wsSection sapUiMediumMarginBottom">
      <Panel headerText="The 45 minutes, the pitch, and how you are marked" expandable="true" expanded="false" width="auto">
        <layout:Grid defaultSpan="XL6 L6 M12 S12" hSpacing="2" vSpacing="1" containerQuery="false">
          <List items="{home>/steps}" headerText="The plan" showSeparators="Inner">
            <StandardListItem title="{home>title}" description="{home>text}" info="{home>time}" icon="{home>icon}" wrapping="true" />
          </List>
          <List items="{home>/rubric}" headerText="Marking (100 points)" showSeparators="Inner">
            <StandardListItem title="{home>criterion}" description="{home>question}" info="{home>points} pts" wrapping="true" />
          </List>
        </layout:Grid>
      </Panel>
    </VBox>
  </Page>
</mvc:View>
