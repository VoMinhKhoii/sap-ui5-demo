<mvc:View
  controllerName="workshop.dashboard.controller.ApiExplorer"
  xmlns="sap.m"
  xmlns:code="sap.ui.codeeditor"
  xmlns:core="sap.ui.core"
  xmlns:layout="sap.ui.layout"
  xmlns:mvc="sap.ui.core.mvc"
>
  <Page showHeader="false" class="wsPage">
    <VBox class="wsPageIntro">
      <Title text="API Explorer" level="H1" titleStyle="H2" />
      <Text text="The ERP tables are the raw records of the company, shaped like SAP S/4HANA APIs. The answers to the cases are in there. Pick a table to see its fields, then query it in the Query Playground." class="sapUiTinyMarginTop" />
    </VBox>
    <layout:Grid defaultSpan="XL4 L4 M12 S12" hSpacing="1" vSpacing="1" containerQuery="false" class="sapUiSmallMarginBeginEnd">
      <List id="endpointList" mode="SingleSelectMaster" selectionChange=".onEndpointSelect" headerText="Endpoints"
        items="{ path: 'explorer>/endpoints', sorter: { path: 'group', group: true } }">
        <StandardListItem title="{explorer>title}" description="{explorer>description}" info="{explorer>info}" wrapping="true" />
      </List>
      <VBox width="100%">
        <layoutData><layout:GridData span="XL8 L8 M12 S12" /></layoutData>
        <OverflowToolbar style="Clear">
          <ObjectStatus text="GET" state="Success" inverted="true" class="sapUiTinyMarginEnd" />
          <Link text="{explorer>/url}" href="{explorer>/url}" target="_blank" />
          <ToolbarSpacer />
          <Text text="{explorer>/usage}" />
        </OverflowToolbar>

        <!-- ERP entity: fields and relations -->
        <VBox visible="{explorer>/isErp}" width="100%">
          <MessageStrip text="{explorer>/entity/description} {explorer>/entity/count} rows. Key: {explorer>/entity/key}." type="Information" showIcon="true" class="sapUiTinyMarginBottom" />
          <Table items="{explorer>/entity/fields}" headerText="Fields" autoPopinMode="true" growing="true" growingThreshold="30">
            <headerToolbar>
              <OverflowToolbar style="Clear">
                <Title text="Fields" level="H3" />
                <ToolbarSpacer />
                <Button text="Try in the Query Playground" icon="sap-icon://simulate" type="Emphasized" press=".onTryInPlayground" />
              </OverflowToolbar>
            </headerToolbar>
            <columns>
              <Column width="14rem"><Text text="Field" /></Column>
              <Column width="6rem"><Text text="Type" /></Column>
              <Column><Text text="Meaning" /></Column>
              <Column width="10rem"><Text text="Example" /></Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{explorer>name}" class="wsMono" />
                  <Text text="{explorer>type}" />
                  <Text text="{explorer>description}" />
                  <Text text="{explorer>exampleText}" wrapping="false" />
                </cells>
              </ColumnListItem>
            </items>
          </Table>
          <Text text="{explorer>/relationsText}" class="sapUiSmallMarginTop sapUiSmallMarginBottom" />
        </VBox>

        <code:CodeEditor type="json" value="{explorer>/response}" editable="false" height="{= ${explorer>/isErp} ? '18rem' : '34rem' }" width="100%" />
        <MessageStrip type="Information" showIcon="true" class="sapUiSmallMarginTop" visible="{= !${explorer>/isErp} }"
          text="Tip: arrays (kpis, trend, breakdown, items, alerts) are bound with items=&quot;\{/kpis\}&quot; or data=&quot;\{/trend\}&quot;. Single values with a full path, e.g. text=&quot;\{/kpis/0/title\}&quot;." />
      </VBox>
    </layout:Grid>
  </Page>
</mvc:View>
