<mvc:View
  controllerName="workshop.dashboard.controller.Gallery"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:code="sap.ui.codeeditor"
>
  <Page id="galleryPage" showHeader="false" class="wsPage">
    <VBox class="wsPageIntro">
      <Title text="Component Gallery" level="H1" titleStyle="H2" />
      <Text text="Every block below is live and shows the sample data of the Coding Club case (\{/kpis\}, \{/trend\} …). Click Copy XML, paste it between a pair of 🧩 markers in your app (webapp/workspace/view/), save and press F5 in your app." class="sapUiTinyMarginTop" />
      <Button text="Show the sample data" icon="sap-icon://source-code" type="Transparent" press=".onShowSampleData" class="sapUiTinyMarginTop" />
    </VBox>
    <IconTabHeader
      id="categoryTabs"
      items="{gallery>/categories}"
      select=".onCategorySelect"
      backgroundDesign="Transparent"
      mode="Inline"
      class="wsCategoryTabs">
      <items>
        <IconTabFilter key="{gallery>key}" text="{gallery>title}" icon="{gallery>icon}" />
      </items>
    </IconTabHeader>
    <MessageStrip id="categoryIntro" text="" showIcon="true" type="Information" class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop" />
    <VBox id="sampleContainer" class="wsSamples" />
    <dependents>
      <Dialog id="sampleDialog" title="Gallery sample data" contentWidth="48rem" contentHeight="70%" resizable="true" draggable="true">
        <VBox class="sapUiSmallMargin">
          <MessageStrip type="Information" showIcon="true" class="sapUiSmallMarginBottom"
            text="The gallery blocks show this data, and it's in your app too, so a pasted block works right away. Lists are bound with items=&quot;\{/kpis\}&quot; or data=&quot;\{/trend\}&quot;, single values with a full path, e.g. text=&quot;\{/kpis/0/title\}&quot;. For the case itself, write your own SQL in the Query Playground." />
          <Select items="{sample>/keys}" selectedKey="{sample>/key}" change=".onSampleKeyChange" width="100%">
            <core:Item key="{sample>key}" text="/{sample>key}" additionalText="{sample>info}" />
          </Select>
          <code:CodeEditor type="json" value="{sample>/json}" editable="false" height="28rem" width="100%" class="sapUiTinyMarginTop" />
        </VBox>
        <endButton>
          <Button text="Close" press=".onCloseSampleData" />
        </endButton>
      </Dialog>
    </dependents>
  </Page>
</mvc:View>
