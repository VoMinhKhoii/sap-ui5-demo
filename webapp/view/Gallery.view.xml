<mvc:View
  controllerName="workshop.dashboard.controller.Gallery"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:code="sap.ui.codeeditor"
  height="100%"
>
  <f:FlexibleColumnLayout id="fcl" layout="TwoColumnsMidExpanded" backgroundDesign="Solid" autoFocus="false">
    <f:beginColumnPages>
      <Page id="listPage" showHeader="false" class="wsPage">
        <VBox class="wsGalleryIntro" renderType="Bare">
          <Title text="Component Gallery" level="H1" titleStyle="H3" />
          <Text text="Working blocks, bound to sample data. Pick one, copy it, paste it into your page." class="sapUiTinyMarginTop" />
          <SearchField id="search" liveChange=".onSearch" placeholder="Search blocks" width="100%" class="sapUiSmallMarginTop" />
          <Link text="Show the sample data" press=".onShowSampleData" class="sapUiSmallMarginTop" />
        </VBox>
        <List id="blockList" mode="SingleSelectMaster" selectionChange=".onBlockSelect" showSeparators="Inner" class="wsBlockList" noDataText="No block matches your search." />
      </Page>
    </f:beginColumnPages>

    <f:midColumnPages>
      <Page id="detailPage" showHeader="false" class="wsPage">
        <VBox class="wsGalleryDetail" renderType="Bare">
          <HBox justifyContent="SpaceBetween" alignItems="Start" wrap="Wrap" renderType="Bare" class="wsGalleryHead">
            <VBox renderType="Bare" class="wsGalleryHeadText">
              <Title text="{detail>/title}" level="H2" titleStyle="H3" wrapping="true" />
              <Text text="{detail>/description}" class="sapUiTinyMarginTop" />
            </VBox>
            <Button text="Copy XML" icon="sap-icon://copy" type="Emphasized" press=".onCopy" />
          </HBox>

          <IconTabBar id="tabs" headerMode="Inline" expandable="false" applyContentPadding="false" backgroundDesign="Transparent" headerBackgroundDesign="Transparent" class="sapUiMediumMarginTop">
            <items>
              <IconTabFilter key="preview" text="Preview">
                <VBox id="preview" renderType="Bare" class="wsPreview" />
              </IconTabFilter>
              <IconTabFilter key="code" text="Code">
                <VBox renderType="Bare" class="wsGalleryCode">
                  <code:CodeEditor type="xml" value="{detail>/code}" editable="false" lineNumbers="true" syntaxHints="false" width="100%" height="{detail>/codeHeight}" />
                  <HBox id="docs" wrap="Wrap" alignItems="Center" class="sapUiSmallMarginTop" />
                </VBox>
              </IconTabFilter>
            </items>
          </IconTabBar>

          <MessageStrip text="{detail>/target}" type="Information" showIcon="true" class="sapUiMediumMarginTop" />
        </VBox>
      </Page>
    </f:midColumnPages>

    <f:dependents>
      <Dialog id="sampleDialog" title="Gallery sample data" contentWidth="48rem" contentHeight="70%" resizable="true" draggable="true">
        <VBox class="sapUiSmallMargin">
          <MessageStrip type="Information" showIcon="true" class="sapUiSmallMarginBottom"
            text="The gallery blocks show this data, and it's in your app too, so a pasted block works right away. Lists are bound with items=&quot;\{/kpis\}&quot; or data=&quot;\{/trend\}&quot;, single values with a full path, e.g. text=&quot;\{/kpis/0/title\}&quot;. For the case itself, write your own SQL in the Query Playground." />
          <Select items="{sample>/keys}" selectedKey="{sample>/key}" change=".onSampleKeyChange" width="100%">
            <core:Item key="{sample>key}" text="/{sample>key}" additionalText="{sample>info}" />
          </Select>
          <code:CodeEditor type="json" value="{sample>/json}" editable="false" height="28rem" width="100%" class="sapUiTinyMarginTop" />
        </VBox>
        <endButton>
          <Button text="Close" press=".onCloseSampleData" />
        </endButton>
      </Dialog>
    </f:dependents>
  </f:FlexibleColumnLayout>
</mvc:View>
