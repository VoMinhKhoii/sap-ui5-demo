<mvc:View
  controllerName="workshop.dashboard.controller.App"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:f="sap.f"
  xmlns:tnt="sap.tnt"
  displayBlock="true"
  height="100%"
>
  <tnt:ToolPage id="toolPage">
    <tnt:header>
      <f:ShellBar
        id="shellBar"
        homeIcon="{app>/logo}"
        homeIconTooltip="The case"
        homeIconPressed=".onHome"
        title="UI5 Workshop"
        secondTitle="The Friday Problem">
        <f:additionalContent>
          <OverflowToolbarButton icon="sap-icon://palette" text="Figma UI Kit" tooltip="SAP S/4HANA Web UI Kit (Figma community)" type="Transparent" press=".onOpenFigma" />
          <OverflowToolbarButton icon="sap-icon://learning-assistant" text="UI5 Docs" tooltip="SAPUI5 documentation" type="Transparent" press=".onOpenDocs" />
        </f:additionalContent>
      </f:ShellBar>
    </tnt:header>
    <tnt:subHeader>
      <!-- The suggested path: four steps, each one a tool. "My app" opens the students' app in a new tab. -->
      <IconTabHeader id="path" selectedKey="home" select=".onPathSelect" backgroundDesign="Solid" class="wsPath">
        <items>
          <IconTabFilter key="home" text="The case" count="0-5 min" />
          <IconTabSeparator icon="sap-icon://process" />
          <IconTabFilter key="playground" text="Query Playground" count="5-25 min" />
          <IconTabSeparator icon="sap-icon://process" />
          <IconTabFilter key="gallery" text="Component Gallery" count="25-40 min" />
          <IconTabSeparator icon="sap-icon://process" />
          <IconTabFilter key="app" text="My app" count="40-45 min" />
        </items>
      </IconTabHeader>
    </tnt:subHeader>
    <tnt:mainContents>
      <App id="app" busy="{app>/busy}" busyIndicatorDelay="300" autoFocus="false" />
    </tnt:mainContents>
  </tnt:ToolPage>
</mvc:View>
