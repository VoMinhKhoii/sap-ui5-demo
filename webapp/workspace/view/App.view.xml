<!--
  ╔══════════════════════════════════════════════════════════════════════╗
  ║  YOUR APP SHELL: the frame around your pages (header + navigation).  ║
  ║                                                                      ║
  ║  Want a sidebar instead of tabs? Gallery → App shells →              ║
  ║  "Copy XML", then replace everything between the 🧩 SHELL markers.   ║
  ║                                                                      ║
  ║  Rules: keep <App id="app" /> (your pages appear there), and keep    ║
  ║  the navigation keys page1, page2, page3 (each opens Page1/2/3).     ║
  ╚══════════════════════════════════════════════════════════════════════╝
-->
<mvc:View
  controllerName="workshop.dashboard.workspace.controller.App"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:f="sap.f"
  xmlns:card="sap.f.cards"
  xmlns:layout="sap.ui.layout"
  xmlns:mc="sap.suite.ui.microchart"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:viz.data="sap.viz.ui5.data"
  xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
  xmlns:tnt="sap.tnt"
  displayBlock="true"
  height="100%"
>
<!-- 🧩 SHELL START (Gallery → App shells) -->
<tnt:ToolPage id="toolPage">
  <tnt:header>
    <f:ShellBar homeIcon="{app>/logo}" title="My app: rename me" secondTitle="For: {/case/client}" />
  </tnt:header>
  <tnt:subHeader>
    <IconTabHeader id="nav" selectedKey="page1" select=".onNavSelect" backgroundDesign="Solid">
      <items>
        <IconTabFilter key="page1" text="The answer" />
        <IconTabFilter key="page2" text="Page 2" />
        <IconTabFilter key="page3" text="Page 3" />
      </items>
    </IconTabHeader>
  </tnt:subHeader>
  <tnt:mainContents>
    <App id="app" autoFocus="false" />
  </tnt:mainContents>
</tnt:ToolPage>
<!-- 🧩 SHELL END -->
</mvc:View>
