<!--
  PAGE 2 (optional stretch goal). Ideas: a deep-dive behind your finding, a list of the records involved,
  or a "List → detail" page (Gallery → App shells): paste it in place of everything between the PAGE markers.
  The navigation item with key "page2" in App.view.xml opens this page.
-->
<mvc:View
  controllerName="workshop.dashboard.workspace.controller.Page"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:f="sap.f"
  xmlns:card="sap.f.cards"
  xmlns:layout="sap.ui.layout"
  xmlns:mc="sap.suite.ui.microchart"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:viz.data="sap.viz.ui5.data"
  xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
  displayBlock="true"
  height="100%"
>
<!-- 🧩 PAGE START (a page layout from Gallery → App shells replaces everything down to PAGE END) -->
<f:DynamicPage id="page2Content" headerExpanded="true" showFooter="false">
  <f:title>
    <f:DynamicPageTitle>
      <f:heading><Title text="Page 2: rename me" level="H1" /></f:heading>
      <f:expandedContent><Text text="What question does this page answer?" /></f:expandedContent>
    </f:DynamicPageTitle>
  </f:title>
  <f:content>
    <VBox width="100%">
      <!-- Rows of cards: each HBox class="wsRow" is a row; cards in it share the width. Add class="wsWide" to make one twice as wide. -->
      <HBox class="wsRow" renderType="Bare">
        <f:Card>
          <f:header>
            <card:Header title="Card: rename me" iconSrc="sap-icon://table-view" />
          </f:header>
          <f:content>
            <VBox width="100%" class="sapUiSmallMargin">
              <!-- 🧩 CARD START -->
              <Text text="Paste a block here" />
              <!-- 🧩 CARD END -->
            </VBox>
          </f:content>
        </f:Card>
      </HBox>

      <!-- 🧩 MORE START (more cards, or Gallery → Page templates) -->

      <!-- 🧩 MORE END -->
    </VBox>
  </f:content>
</f:DynamicPage>
<!-- 🧩 PAGE END -->
</mvc:View>
