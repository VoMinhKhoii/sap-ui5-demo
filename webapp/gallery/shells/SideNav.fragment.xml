<core:FragmentDefinition
  xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:layout="sap.ui.layout"
  xmlns:mc="sap.suite.ui.microchart" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds" xmlns:tnt="sap.tnt">
<!-- App shell: header bar + collapsible side navigation. Each item's key opens a page (page1, page2, page3). Keep App id="app": your pages appear there. -->
<tnt:ToolPage id="toolPage">
  <tnt:header>
    <tnt:ToolHeader>
      <Button icon="sap-icon://menu2" type="Transparent" press=".onToggleSideNav" tooltip="Toggle navigation">
        <layoutData><OverflowToolbarLayoutData priority="NeverOverflow" /></layoutData>
      </Button>
      <Avatar initials="NM" displaySize="XS" backgroundColor="Accent6" />
      <Title text="My app: rename me" level="H1" wrapping="false" />
      <ToolbarSpacer />
      <Text text="{/case/client}" wrapping="false" />
    </tnt:ToolHeader>
  </tnt:header>
  <tnt:sideContent>
    <tnt:SideNavigation id="nav" selectedKey="page1" itemSelect=".onNavSelect">
      <tnt:NavigationList>
        <tnt:NavigationListItem key="page1" text="The answer" icon="sap-icon://business-objects-experience" />
        <tnt:NavigationListItem key="page2" text="Page 2" icon="sap-icon://table-view" />
        <tnt:NavigationListItem key="page3" text="Page 3" icon="sap-icon://line-chart" />
      </tnt:NavigationList>
    </tnt:SideNavigation>
  </tnt:sideContent>
  <tnt:mainContents>
    <App id="app" />
  </tnt:mainContents>
</tnt:ToolPage>
</core:FragmentDefinition>
