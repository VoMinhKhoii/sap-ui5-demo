<core:FragmentDefinition
  xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:layout="sap.ui.layout"
  xmlns:mc="sap.suite.ui.microchart" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds" xmlns:tnt="sap.tnt">
<!-- Page layout "List → detail": pick a club on the left, see its events on the right.
     Paste it into a page view in place of everything between the PAGE markers. Uses {/clubList} (sample data, always there).
     Inside the detail column, bindings are relative to the selected club: {name}, items="{eventList}". -->
<f:FlexibleColumnLayout layout="OneColumn" backgroundDesign="Solid">
  <f:beginColumnPages>
    <f:DynamicPage showFooter="false">
      <f:title>
        <f:DynamicPageTitle>
          <f:heading><Title text="Clubs" level="H2" /></f:heading>
          <f:expandedContent><Text text="Click a club to see its events" /></f:expandedContent>
        </f:DynamicPageTitle>
      </f:title>
      <f:content>
        <List items="{/clubList}" mode="SingleSelectMaster" selectionChange=".onShowDetail">
          <ObjectListItem title="{name}" number="{fill_pct}" numberUnit="% seats filled">
            <attributes>
              <ObjectAttribute text="{category} · {members} members" />
            </attributes>
          </ObjectListItem>
        </List>
      </f:content>
    </f:DynamicPage>
  </f:beginColumnPages>
  <f:midColumnPages>
    <f:DynamicPage showFooter="false">
      <f:title>
        <f:DynamicPageTitle>
          <f:heading><Title text="{name}" level="H2" /></f:heading>
          <f:expandedContent><Text text="Club {club_id} · {category} · organiser {organiser}" /></f:expandedContent>
          <f:navigationActions>
            <Button icon="sap-icon://decline" type="Transparent" press=".onCloseDetail" tooltip="Close" />
          </f:navigationActions>
        </f:DynamicPageTitle>
      </f:title>
      <f:header>
        <f:DynamicPageHeader>
          <HBox wrap="Wrap">
            <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
              <Label text="Seats filled" />
              <ObjectNumber number="{fill_pct}" unit="%" emphasized="true" />
            </VBox>
            <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
              <Label text="Show-up" />
              <ObjectNumber number="{showup_pct}" unit="%" />
            </VBox>
            <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
              <Label text="Members" />
              <ObjectNumber number="{members}" />
            </VBox>
          </HBox>
        </f:DynamicPageHeader>
      </f:header>
      <f:content>
        <Table items="{eventList}" autoPopinMode="true" headerText="Events ({= ${eventList} ? ${eventList}.length : 0 })">
          <columns>
            <Column><Text text="Event" /></Column>
            <Column><Text text="When" /></Column>
            <Column><Text text="Room" /></Column>
            <Column hAlign="End"><Text text="Seats filled" /></Column>
            <Column hAlign="End"><Text text="Rating" /></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <ObjectIdentifier title="{title}" text="{topic}" />
                <Text text="{weekday} { path: 'date', formatter: '.formatter.date' }, {start_time}" />
                <Text text="{room}" />
                <ObjectNumber number="{fill_pct}" unit="%" state="{= ${fill_pct} >= 80 ? 'Success' : ${fill_pct} >= 60 ? 'Warning' : 'Error' }" />
                <ObjectNumber number="{avg_rating}" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </f:content>
    </f:DynamicPage>
  </f:midColumnPages>
</f:FlexibleColumnLayout>
</core:FragmentDefinition>
