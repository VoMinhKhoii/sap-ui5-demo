<core:FragmentDefinition
  xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:layout="sap.ui.layout"
  xmlns:mc="sap.suite.ui.microchart" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
<!-- Notification list: like the SAP Fiori launchpad inbox (/alerts). -->
<List items="{/alerts}" headerText="Needs your attention">
  <!-- ui5lint-disable-next-line no-deprecated-api -->
  <NotificationListItem datetime="{ path: 'date', formatter: '.formatter.date' }"
    title="{title}"
    description="{description}"
    priority="{ path: 'type', formatter: '.formatter.priority' }"
    showCloseButton="false"
    press=".onItemPress" />
</List>
</core:FragmentDefinition>
