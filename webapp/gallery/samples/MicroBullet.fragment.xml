<core:FragmentDefinition
  xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:layout="sap.ui.layout"
  xmlns:mc="sap.suite.ui.microchart" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
<!-- Bullet micro charts: actual vs. target for every KPI, in a list. -->
<List items="{/kpis}" showSeparators="Inner">
  <CustomListItem>
    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMargin">
      <VBox>
        <Title text="{title}" level="H5" />
        <Text text="{ parts: ['target', 'unit'], formatter: '.formatter.target' }" />
      </VBox>
      <mc:BulletMicroChart size="M" targetValue="{target}" showTargetValue="false" width="12rem">
        <mc:actual>
          <mc:BulletMicroChartData value="{value}" color="{state}" />
        </mc:actual>
      </mc:BulletMicroChart>
    </HBox>
  </CustomListItem>
</List>
</core:FragmentDefinition>
