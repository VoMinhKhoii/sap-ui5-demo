<core:FragmentDefinition
  xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:layout="sap.ui.layout"
  xmlns:mc="sap.suite.ui.microchart" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
<!-- Bullet chart: one bar per plant/region, actual against a target marker (/breakdown). -->
<viz:VizFrame vizType="bullet" width="100%" height="20rem" uiConfig="{applicationSet:'fiori'}" selectData=".onChartSelect">
  <viz:dataset>
    <viz.data:FlattenedDataset data="{/breakdown}">
      <viz.data:dimensions>
        <viz.data:DimensionDefinition name="Name" value="{name}" />
      </viz.data:dimensions>
      <viz.data:measures>
        <viz.data:MeasureDefinition name="Actual" value="{value}" />
        <viz.data:MeasureDefinition name="Target" value="{target}" />
      </viz.data:measures>
    </viz.data:FlattenedDataset>
  </viz:dataset>
  <viz:feeds>
    <viz.feeds:FeedItem uid="actualValues" type="Measure" values="Actual" />
    <viz.feeds:FeedItem uid="targetValues" type="Measure" values="Target" />
    <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Name" />
  </viz:feeds>
</viz:VizFrame>
</core:FragmentDefinition>
