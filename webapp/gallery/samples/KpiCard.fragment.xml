<core:FragmentDefinition
  xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:layout="sap.ui.layout"
  xmlns:mc="sap.suite.ui.microchart" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
<!-- One KPI card. binding="{/kpis/0}" picks the first KPI. Change 0 to 1, 2 or 3 for the others. -->
<f:Card binding="{/kpis/0}" width="100%">
  <f:header>
    <card:NumericHeader
      title="{title}"
      subtitle="{subtitle}"
      iconSrc="{icon}"
      number="{ path: 'value', formatter: '.formatter.compactNumber' }"
      unitOfMeasurement="{unit}"
      trend="{trend}"
      state="{state}"
      details="{ parts: ['target', 'unit'], formatter: '.formatter.target' }"
      press=".onKpiPress">
      <card:sideIndicators>
        <card:NumericSideIndicator title="Target" number="{ path: 'target', formatter: '.formatter.compactNumber' }" unit="{unit}" />
        <card:NumericSideIndicator title="Change" number="{ path: 'deltaPercent', formatter: '.formatter.delta' }" />
      </card:sideIndicators>
    </card:NumericHeader>
  </f:header>
</f:Card>
</core:FragmentDefinition>
