<core:FragmentDefinition
  xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:layout="sap.ui.layout"
  xmlns:mc="sap.suite.ui.microchart" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
<!-- 12-column grid. span="L8" = 8 of 12 columns on large screens; S12 = full width on phones. -->
<layout:Grid defaultSpan="XL6 L6 M12 S12" hSpacing="1" vSpacing="1" containerQuery="true">
  <f:Card width="100%" height="10rem">
    <f:layoutData><layout:GridData span="XL8 L8 M12 S12" /></f:layoutData>
    <f:header><card:Header title="Wide card (8 of 12)" /></f:header>
  </f:Card>
  <f:Card width="100%" height="10rem">
    <f:layoutData><layout:GridData span="XL4 L4 M12 S12" /></f:layoutData>
    <f:header><card:Header title="Narrow card (4 of 12)" /></f:header>
  </f:Card>
  <f:Card width="100%" height="10rem">
    <f:header><card:Header title="Half (default span 6)" /></f:header>
  </f:Card>
  <f:Card width="100%" height="10rem">
    <f:header><card:Header title="Half (default span 6)" /></f:header>
  </f:Card>
</layout:Grid>
</core:FragmentDefinition>
