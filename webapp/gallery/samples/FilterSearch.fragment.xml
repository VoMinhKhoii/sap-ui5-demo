<core:FragmentDefinition
  xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:card="sap.f.cards" xmlns:layout="sap.ui.layout"
  xmlns:mc="sap.suite.ui.microchart" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data" xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">
<!-- Search field + view switch, typically in a card or table toolbar. -->
<OverflowToolbar>
  <Title text="{/meta/items/title}" level="H3" />
  <ToolbarSpacer />
  <SearchField width="14rem" placeholder="Search" search=".onActionPress" />
  <SegmentedButton selectedKey="table">
    <items>
      <SegmentedButtonItem key="table" icon="sap-icon://table-view" tooltip="Table" />
      <SegmentedButtonItem key="chart" icon="sap-icon://bar-chart" tooltip="Chart" />
    </items>
  </SegmentedButton>
  <Button icon="sap-icon://excel-attachment" type="Transparent" tooltip="Export" press=".onActionPress" />
</OverflowToolbar>
</core:FragmentDefinition>
